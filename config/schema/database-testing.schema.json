{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guthon.local/schema/database-testing.schema.json",
  "title": "谷神数据库测试目标映射",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expectedIdentities", "databaseTests"],
  "properties": {
    "schemaVersion": {"const": 1},
    "connections": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/connection"}
    },
    "expectedIdentities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/identity"}
    },
    "databaseTests": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(products|projects)\\.[A-Za-z0-9._-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets"],
          "properties": {
            "defaults": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "diagnosisTargetId": {"type": "string", "minLength": 1},
                "byEnvironment": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "dev": {"type": "string", "minLength": 1},
                    "test": {"type": "string", "minLength": 1}
                  }
                }
              }
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/target"}
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "endpoint", "database", "evidenceRef"],
      "properties": {
        "engine": {"enum": ["mysql", "postgresql", "oracle"]},
        "endpoint": {"type": "string", "minLength": 1},
        "database": {"$ref": "#/$defs/identifier"},
        "schema": {"$ref": "#/$defs/identifier"},
        "evidenceRef": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"engine": {"const": "oracle"}}},
          "then": {"required": ["schema"]}
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "host", "port", "database", "username", "credentialRef"],
      "properties": {
        "engine": {"enum": ["mysql", "postgresql", "oracle"]},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"$ref": "#/$defs/identifier"},
        "schema": {"$ref": "#/$defs/identifier"},
        "username": {"type": "string", "minLength": 1},
        "credentialRef": {"type": "string", "minLength": 1},
        "connectTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60}
      },
      "allOf": [
        {
          "if": {"properties": {"engine": {"const": "oracle"}}},
          "then": {"required": ["schema"]}
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "database", "environment", "access", "expectedIdentityRef"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "systemId": {"type": "string", "minLength": 1},
        "dataSourceId": {"type": "string", "minLength": 1},
        "connectionId": {"type": "string", "minLength": 1},
        "connectionRef": {"type": "string", "minLength": 1},
        "validationScope": {"enum": ["diagnosis-only", "full"]},
        "database": {"$ref": "#/$defs/identifier"},
        "schema": {"$ref": "#/$defs/identifier"},
        "environment": {"enum": ["dev", "test"]},
        "access": {"const": "read-only"},
        "expectedIdentityRef": {"type": "string", "minLength": 1},
        "allowedTables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"},
          "not": {"contains": {"const": "*"}}
        },
        "tenantScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "evidenceRef"],
          "properties": {
            "field": {"$ref": "#/$defs/identifier"},
            "evidenceRef": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "anyOf": [
            {"required": ["connectionId"]},
            {"required": ["connectionRef"]}
          ]
        },
        {
          "if": {
            "not": {"properties": {"validationScope": {"const": "diagnosis-only"}}, "required": ["validationScope"]}
          },
          "then": {"required": ["systemId", "dataSourceId", "allowedTables", "tenantScope"]}
        }
      ]
    }
  }
}
