{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guthon.local/schema/database-test-plan.schema.json",
  "title": "谷神数据库测试计划",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "workspaceKey", "sourceMode", "sourceDigest", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "minLength": 1},
    "workspaceKey": {"type": "string", "pattern": "^(products|projects)\\.[A-Za-z0-9._-]+$"},
    "sourceMode": {"enum": ["database", "svn"]},
    "sourceDigest": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sql", "assert"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sql": {"type": "string", "pattern": "^\\s*SELECT\\b"},
        "assert": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "enum": ["scalar_equals", "decimal_equals", "rows_empty", "row_count_equals", "keyed_rows_equals"]
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId", "requirementIds", "targetId", "level", "sourceEvidence",
        "checks", "expectedBasis", "cleanup"
      ],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "requirementIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "targetId": {"type": "string", "minLength": 1},
        "level": {"enum": ["query", "platform-result"]},
        "sourceEvidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "preconditions": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "expectedBasis": {"type": "string", "minLength": 1},
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "reason"],
          "properties": {
            "required": {"type": "boolean"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "platform": {
          "type": "object",
          "description": "platform-result 用例所需的环境、版本、关联 ID 和触发证据要求"
        }
      }
    }
  }
}
