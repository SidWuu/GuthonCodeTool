  "main": "./src/extension.js",
  "contributes": {
    "configurationDefaults": {
      "workbench.list.horizontalScrolling": true,
      "scm.alwaysShowActions": true,
      "scm.repositories.selectionMode": "multiple"
    },
    "languages": [
      {
        "id": "guthon-gss",
        "aliases": ["Guthon GSS","gss"],
        "extensions": [".gss"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "java",
        "extensions": [".vm"]
      }
    ],
    "grammars": [
      {"language":"guthon-gss","scopeName":"source.guthon-gss","path":"./syntaxes/guthon-gss.tmLanguage.json"},
      {
        "scopeName": "guthon-gss.injection",
        "path": "./syntaxes/guthon-gss.injection.tmLanguage.json",
        "injectTo": ["source.guthon-gss"]
      }
    ],
    "configuration": {
      "title": "Guthon Nexus",
      "properties": {
        "gushenCompletion.onboarding": {
          "type": "boolean",
          "default": false,
          "description": "从零安装后显示尚未完成的一次性工具与插件安装确认，完成后日常不再显示。"
        },
        "gushenCompletion.autoStartBridge": {
          "type": "boolean",
          "default": false,
          "description": "在已信任的 Guthon 工作区自动启动本机 Bridge；统一安装器配置的工作区默认启用。"
        },
        "gushenCompletion.bridgePort": {
          "type": "integer",
          "default": 17361,
          "minimum": 1,
          "maximum": 65535,
          "description": "Bridge 本机端口。修改后停止并重新启动 Bridge，并在 Chrome 配对设置中填写同一端口。"
        },
        "gushenCompletion.rulesPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a custom rules.json file. Empty means use the extension bundled rules.json."
        },
        "gushenCompletion.procedureTreeLayout": {
          "type": "string",
          "enum": ["tree", "flat"],
          "default": "tree",
          "description": "过程函数包按目录层级或完整包名显示。"
        },
        "gushenCompletion.sourceTreeOrder": {
          "type": "string",
          "enum": [
            "platform",
            "name"
          ],
          "default": "platform",
          "description": "源码树同级排序：platform 按当前项目的数据源 ID 排列分组，分组内按菜单或对象顺序排列。name 按显示名称排列。"
        },
        "gushenCompletion.toolPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the packaged GuthonCodeTool executable."
        },
        "gushenCompletion.toolHome": {
          "type": "string",
          "default": "",
          "description": "Absolute directory for GuthonCodeTool local configuration, API checkout, and indexes."
        },
        "gushenCompletion.executionMode": {
          "type": "string",
          "enum": ["packaged","source-development","script"],
          "default": "packaged",
          "description": "Use the packaged app, local source checkout, or Release Python zipapp."
        },
        "gushenCompletion.autoCheckUpdates": {
          "type": "boolean",
          "default": true,
          "description": "每天首次激活 Nexus 后后台检查三组件更新；只检查，不自动安装。"
        },
        "gushenCompletion.updateSource": {
          "type": "string",
          "enum": ["github","gitee"],
          "enumDescriptions": ["GitHub Release","Gitee Release"],
          "default": "gitee",
          "description": "Guthon 三组件统一更新源；发行和调试模式均可检查更新。"
        },
        "gushenCompletion.developmentRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the GuthonCodeTool source checkout used in development mode."
        },
        "gushenCompletion.scriptPythonPath": {
          "type": "string",
          "default": "",
          "description": "Absolute Python executable path for Release zipapp debug mode."
        },
        "gushenCompletion.scriptToolPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to GuthonCodeTool-python.pyz for debug mode."
        }
      }
    },
    "commands": [
      {"command":"gushenCompletion.openSvnChangeInNexus","title":"打开 SVN 源码变更","category":"Guthon Nexus"},
      {"command":"gushenCompletion.revertSingleSvnChange","title":"审阅并撤销 SVN 文件","category":"Guthon Nexus"},
      {"command":"gushenCompletion.saveSelectedSvnNexusChanges","title":"审阅并提交所选 SVN 文件","category":"Guthon Nexus"},
      {"command":"gushenCompletion.markSvnConflictResolved","title":"标记 SVN 冲突为已解决","category":"Guthon Nexus"},
