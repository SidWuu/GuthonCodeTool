{
  "name": "guthon-nexus-vscode",
  "displayName": "Guthon Nexus",
  "description": "Guthon API workspace, source management, database diagnostics, completions, hover documentation, and source navigation.",
  "version": "2.8.1",
  "publisher": "gushen-local",
  "icon": "resources/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished",
    "onLanguage:java",
    "onLanguage:guthon-gss",
    "onLanguage:javascript",
    "onLanguage:sql",
    "onCommand:gushenCompletion.setupTool",
    "onCommand:gushenCompletion.addWorkspace",
    "onCommand:gushenCompletion.deleteWorkspace",
    "onCommand:gushenCompletion.configureDatabaseDiagnosis",
    "onCommand:gushenCompletion.selectExecutionMode",
    "onCommand:gushenCompletion.restartDevelopmentToolHost",
    "onCommand:gushenCompletion.selectUpdateSource",
    "onCommand:gushenCompletion.checkToolUpdate",
    "onCommand:gushenCompletion.rollbackToolUpdate",
    "onCommand:gushenCompletion.exportAiContext",
    "onCommand:gushenCompletion.searchWorkspace",
    "onCommand:gushenCompletion.showPullHistory",
    "onCommand:gushenCompletion.archivePullHistory",
    "onCommand:gushenCompletion.restorePullHistory",
    "onCommand:gushenCompletion.showDiagnosisHistory",
    "onCommand:gushenCompletion.startBridge",
    "onCommand:gushenCompletion.stopBridge",
    "onCommand:gushenCompletion.openWorkspace",
    "onCommand:gushenCompletion.openToolHome",
    "onCommand:gushenCompletion.editConfig",
    "onCommand:gushenCompletion.reindexCalls",
    "onCommand:gushenCompletion.retryApiIndexFailures",
    "onCommand:gushenCompletion.exportMarkdown",
    "onCommand:gushenCompletion.exportSchema",
    "onCommand:gushenCompletion.exportBillTypes",
    "onCommand:gushenCompletion.exportSystemScripts",
    "onCommand:gushenCompletion.exportViews",
    "onCommand:gushenCompletion.runDoctor",
    "onCommand:gushenCompletion.runDiagnosis",
    "onCommand:gushenCompletion.refreshToolView",
    "onView:gushenCompletion.toolView",
    "onView:gushenCompletion.projectDetails",
    "onView:gushenCompletion.sourceView",
    "onFileSystem:guthon-api-edit",
    "onCommand:gushenCompletion.configureApiSource",
    "onCommand:gushenCompletion.loginApiSource",
    "onCommand:gushenCompletion.selectApiSystems",
    "onCommand:gushenCompletion.pullApiSource",
    "onCommand:gushenCompletion.openApiCheckout",
    "onCommand:gushenCompletion.showApiStatus",
    "onCommand:gushenCompletion.refreshApiSourceView",
    "onCommand:gushenCompletion.refreshApiScm",
    "onCommand:gushenCompletion.openApiSource",
    "onCommand:gushenCompletion.openApiOriginalSource",
    "onCommand:gushenCompletion.previewApiSource",
    "onCommand:gushenCompletion.showApiDiff",
    "onCommand:gushenCompletion.revertApiSource",
    "onCommand:gushenCompletion.revertApiQuickDiffChange",
    "onCommand:gushenCompletion.uploadApiSource",
    "onCommand:gushenCompletion.refreshApiObject",
    "onCommand:gushenCompletion.showApiIndexDiagnostics",
    "onCommand:gushenCompletion.openApiDesigner",
    "onCommand:gushenCompletion.openApiPageEditor",
    "onCommand:gushenCompletion.openApiFragment",
    "onCommand:gushenCompletion.openApiFieldCollection",
    "onCommand:gushenCompletion.editApiPage",
    "onCommand:gushenCompletion.searchApiSource",
    "onCommand:gushenCompletion.resolveApiConflict",
    "onCommand:gushenCompletion.syncApiDatabase",
    "onCommand:gushenCompletion.showApiHistory",
    "onCommand:gushenCompletion.verifyApiUpload",
    "onCommand:gushenCompletion.createApiFunction",
    "onCommand:gushenCompletion.showApiSystemMenu",
    "onCommand:gushenCompletion.exportApiChanges",
    "onCommand:gushenCompletion.importApiChanges",
    "onCommand:gushenCompletion.checkOfficialUpdate",
    "onCommand:gushenCompletion.rollbackOfficialUpdate",
    "onCommand:gushenCompletion.searchCurrentApiWorkspace",
    "onCommand:gushenCompletion.quickOpenApiSource",
    "onCommand:gushenCompletion.locateApiPageById",
    "onCommand:gushenCompletion.locateApiProcedureByName",
    "onCommand:gushenCompletion.showApiPageNodes",
    "onCommand:gushenCompletion.showApiProcedureCallers",
    "onCommand:gushenCompletion.copyApiProcedureName",
    "onCommand:gushenCompletion.copyApiQualifiedProcedureName",
    "onCommand:gushenCompletion.browseApiImpactEvidence",
    "onCommand:gushenCompletion.showApiImpact",
    "onCommand:gushenCompletion.searchApiPageFields",
    "onCommand:gushenCompletion.locateActiveApiSource",
    "onCommand:gushenCompletion.focusApiSource",
    "onCommand:gushenCompletion.expandApiSelectedSource",
    "onCommand:gushenCompletion.collapseApiSelectedSource",
    "onCommand:gushenCompletion.refreshAllApiSources",
    "onCommand:gushenCompletion.copyApiLocatorLink",
    "onCommand:gushenCompletion.copyApiAiContext",
    "onCommand:gushenCompletion.openApiSourceInBrowser",
    "onCommand:gushenCompletion.showApiInheritance"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configurationDefaults": {
      "workbench.list.horizontalScrolling": true,
      "scm.alwaysShowActions": true,
      "scm.repositories.selectionMode": "multiple"
    },
    "languages": [
      {
        "id": "guthon-gss",
        "aliases": ["Guthon GSS","gss"],
        "extensions": [".gss"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "java",
        "extensions": [".vm"]
      }
    ],
    "grammars": [
      {"language":"guthon-gss","scopeName":"source.guthon-gss","path":"./syntaxes/guthon-gss.tmLanguage.json"},
      {
        "scopeName": "guthon-gss.injection",
        "path": "./syntaxes/guthon-gss.injection.tmLanguage.json",
        "injectTo": ["source.guthon-gss"]
      }
    ],
    "configuration": {
      "title": "Guthon Nexus",
      "properties": {
        "gushenCompletion.onboarding": {
          "type": "boolean",
          "default": false,
          "description": "从零安装后显示尚未完成的一次性工具与插件安装确认，完成后日常不再显示。"
        },
        "gushenCompletion.autoStartBridge": {
          "type": "boolean",
          "default": false,
          "description": "在已信任的 Guthon 工作区自动启动本机 Bridge；统一安装器配置的工作区默认启用。"
        },
        "gushenCompletion.bridgePort": {
          "type": "integer",
          "default": 17361,
          "minimum": 1,
          "maximum": 65535,
          "description": "Bridge 本机端口。修改后停止并重新启动 Bridge，并在 Chrome 配对设置中填写同一端口。"
        },
        "gushenCompletion.rulesPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a custom rules.json file. Empty means use the extension bundled rules.json."
        },
        "gushenCompletion.toolPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the packaged GuthonCodeTool executable."
        },
        "gushenCompletion.toolHome": {
          "type": "string",
          "default": "",
          "description": "Absolute directory for GuthonCodeTool local configuration, API checkout, and indexes."
        },
        "gushenCompletion.executionMode": {
          "type": "string",
          "enum": ["packaged","source-development","script"],
          "default": "packaged",
          "description": "Use the packaged app, local source checkout, or Release Python zipapp."
        },
        "gushenCompletion.autoCheckUpdates": {
          "type": "boolean",
          "default": true,
          "description": "每天首次激活 Nexus 后后台检查三组件更新；只检查，不自动安装。"
        },
        "gushenCompletion.updateSource": {
          "type": "string",
          "enum": ["github","gitee"],
          "enumDescriptions": ["GitHub Release","Gitee Release"],
          "default": "gitee",
          "description": "Guthon 三组件统一更新源；发行和调试模式均可检查更新。"
        },
        "gushenCompletion.developmentRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the GuthonCodeTool source checkout used in development mode."
        },
        "gushenCompletion.scriptPythonPath": {
          "type": "string",
          "default": "",
          "description": "Absolute Python executable path for Release zipapp debug mode."
        },
        "gushenCompletion.scriptToolPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to GuthonCodeTool-python.pyz for debug mode."
        }
      }
    },
    "commands": [
      {"command":"gushenCompletion.configureApiSource","title":"Guthon Nexus: 配置 API 项目地址"},
      {"command":"gushenCompletion.loginApiSource","title":"Guthon Nexus: 登录 API 项目"},
      {"command":"gushenCompletion.selectApiSystems","title":"Guthon Nexus: 选择 API 子系统"},
      {"command":"gushenCompletion.pullApiSource","title":"Guthon Nexus: 通过 API 拉取源码"},
      {"command":"gushenCompletion.openApiCheckout","title":"Guthon Nexus: 在独立窗口打开项目"},
      {"command":"gushenCompletion.showApiStatus","title":"Guthon Nexus: 查看 API 源码状态"},
      {"command":"gushenCompletion.openOnboarding","title":"Guthon Nexus: 一次性安装配置助手"},
      {"command":"gushenCompletion.archivePullHistory","title":"Guthon Nexus: 归档本地拉取历史"},
      {"command":"gushenCompletion.restorePullHistory","title":"Guthon Nexus: 恢复拉取历史归档"},
      {"command":"gushenCompletion.showPullHistory","title":"Guthon Nexus: 查看源码拉取历史"},
      {"command":"gushenCompletion.showDiagnosisHistory","title":"Guthon Nexus: 查看最近诊断历史"},
      {"command":"gushenCompletion.setupTool","title":"Guthon Nexus: 设置/切换工作空间"},
      {"command":"gushenCompletion.addWorkspace","title":"Guthon Nexus: 添加产品或项目","icon":"$(add)"},
      {"command":"gushenCompletion.deleteWorkspace","title":"Guthon Nexus: 删除产品或项目","icon":"$(trash)"},
      {"command":"gushenCompletion.configureDatabaseDiagnosis","title":"Guthon Nexus: 配置数据库只读目标","icon":"$(database)"},
      {"command":"gushenCompletion.selectExecutionMode","title":"Guthon Nexus: 切换运行模式"},
      {"command":"gushenCompletion.restartDevelopmentToolHost","title":"Guthon Nexus: 重启开发 ToolHost"},
      {"command":"gushenCompletion.selectUpdateSource","title":"Guthon Nexus: 选择 GuthonCodeTool 更新源"},
      {"command":"gushenCompletion.checkToolUpdate","title":"Guthon Nexus: 检查更新"},
      {"command":"gushenCompletion.rollbackToolUpdate","title":"Guthon Nexus: 回退 GuthonCodeTool 版本"},
      {"command":"gushenCompletion.exportAiContext","title":"Guthon Nexus: 导出 AI 上下文文件","icon":"$(export)"},
      {"command":"gushenCompletion.searchWorkspace","title":"Guthon Nexus: 搜索工作区完整索引","icon":"$(search)"},
      {"command":"gushenCompletion.startBridge","title":"Guthon Nexus: 启动 Guthon Bridge"},
      {"command":"gushenCompletion.stopBridge","title":"Guthon Nexus: 停止 Guthon Bridge"},
      {"command":"gushenCompletion.openWorkspace","title":"Guthon Nexus: 打开工作区目录"},
      {"command":"gushenCompletion.openToolHome","title":"Guthon Nexus: 打开本地数据目录"},
      {"command":"gushenCompletion.editConfig","title":"Guthon Nexus: 编辑配置文件"},
      {"command":"gushenCompletion.retryApiIndexFailures","title":"Guthon Nexus: 重试待更新索引"},
      {"command":"gushenCompletion.reindexCalls","title":"Guthon Nexus: 重建索引"},
      {"command":"gushenCompletion.exportMarkdown","title":"Guthon Nexus: 导出源码索引文档"},
      {"command":"gushenCompletion.exportSchema","title":"Guthon Nexus: 导出表结构"},
      {"command":"gushenCompletion.exportBillTypes","title":"Guthon Nexus: 导出单据类型"},
      {"command":"gushenCompletion.exportSystemScripts","title":"Guthon Nexus: 导出系统脚本"},
      {"command":"gushenCompletion.exportViews","title":"Guthon Nexus: 导出视图源码"},
      {"command":"gushenCompletion.runDoctor","title":"Guthon Nexus: 检查本地环境"},
      {"command":"gushenCompletion.runDiagnosis","title":"Guthon Nexus: 执行源码逻辑排查"},
      {"command":"gushenCompletion.refreshToolView","title":"Guthon Nexus: 刷新已有工作空间状态","icon":"$(refresh)"},
      {"command":"gushenCompletion.refreshApiSourceView","title":"Guthon Nexus: 刷新指定 API 项目源码"},
      {"command":"gushenCompletion.refreshApiScm","title":"Guthon Nexus: 刷新 API 变更"},
      {"command":"gushenCompletion.openApiOriginalSource","title":"Guthon Nexus: 打开原始源码"},
      {"command":"gushenCompletion.openApiSource","title":"Guthon Nexus: 打开 API 源码"},
      {"command":"gushenCompletion.previewApiSource","title":"Guthon Nexus: 预览原始源码"},
      {"command":"gushenCompletion.showApiDiff","title":"Guthon Nexus: 查看 API 源码差异"},
      {"command":"gushenCompletion.revertApiQuickDiffChange","title":"Guthon Nexus: 还原当前差异块"},
      {"command":"gushenCompletion.revertApiSource","title":"Guthon Nexus: 还原 API 本地修改"},
      {"command":"gushenCompletion.uploadApiSource","title":"Guthon Nexus: 上传 API 本地修改"},
      {"command":"gushenCompletion.showApiIndexDiagnostics","title":"Guthon Nexus: 查看 API 索引诊断"},
      {"command":"gushenCompletion.refreshApiObject","title":"Guthon Nexus: 更新指定 API 源码"},
      {"command":"gushenCompletion.openApiDesigner","title":"Guthon Nexus: 打开在线页面设计器"},
      {"command":"gushenCompletion.openApiFieldCollection","title":"Guthon Nexus: 打开 PAGE 字段集合 JSON"},
      {"command":"gushenCompletion.openApiFragment","title":"Guthon Nexus: 打开 PAGE 源码分块"},
      {"command":"gushenCompletion.openApiPageEditor","title":"Guthon Nexus: 打开 PAGE 管理器"},
      {"command":"gushenCompletion.editApiPage","title":"Guthon Nexus: 编辑 PAGE"},
      {"command":"gushenCompletion.searchApiSource","title":"Guthon Nexus: 搜索 API 源码"},
      {"command":"gushenCompletion.resolveApiConflict","title":"Guthon Nexus: 处理 API 源码冲突"},
      {"command":"gushenCompletion.syncApiDatabase","title":"Guthon Nexus: 同步表或视图结构"},
      {"command":"gushenCompletion.showApiHistory","title":"Guthon Nexus: 查看 API 操作历史"},
      {"command":"gushenCompletion.createApiFunction","title":"Guthon Nexus: 创建过程函数"},
      {"command":"gushenCompletion.exportApiChanges","title":"Guthon Nexus: 导出本地修改包"},
      {"command":"gushenCompletion.importApiChanges","title":"Guthon Nexus: 预览并导入本地修改包"},
      {"command":"gushenCompletion.showApiSystemMenu","title":"Guthon Nexus: 查看系统菜单"},
      {"command":"gushenCompletion.verifyApiUpload","title":"Guthon Nexus: 回读核对未知上传"},
      {"command":"gushenCompletion.checkOfficialUpdate","title":"Guthon Nexus: 检查谷神官方能力更新"},
      {"command":"gushenCompletion.rollbackOfficialUpdate","title":"Guthon Nexus: 回退官方能力资源"},
      {"command":"gushenCompletion.searchCurrentApiWorkspace","title":"Guthon Nexus: 搜索当前 API 项目"},
      {"command":"gushenCompletion.quickOpenApiSource","title":"Guthon Nexus: 快速打开 API 源码"},
      {"command":"gushenCompletion.locateApiPageById","title":"Guthon Nexus: 按页面编码定位"},
      {"command":"gushenCompletion.locateApiProcedureByName","title":"Guthon Nexus: 按包名与函数名定位"},
      {"command":"gushenCompletion.showApiPageNodes","title":"Guthon Nexus: 浏览 PAGE 代码节点"},
      {"command":"gushenCompletion.copyApiProcedureName","title":"Guthon Nexus: 复制函数名"},
      {"command":"gushenCompletion.copyApiQualifiedProcedureName","title":"Guthon Nexus: 复制包名.函数名"},
      {"command":"gushenCompletion.showApiProcedureCallers","title":"Guthon Nexus: 查看函数调用方"},
      {"command":"gushenCompletion.browseApiImpactEvidence","title":"Guthon Nexus: 浏览影响证据"},
      {"command":"gushenCompletion.showApiImpact","title":"Guthon Nexus: 预览源码影响"},
      {"command":"gushenCompletion.searchApiPageFields","title":"Guthon Nexus: 查找 PAGE 字段"},
      {"command":"gushenCompletion.locateActiveApiSource","title":"Guthon Nexus: 定位当前源码"},
      {"command":"gushenCompletion.expandApiSelectedSource","title":"Guthon Nexus: 展开所选源码节点"},
      {"command":"gushenCompletion.collapseApiSelectedSource","title":"Guthon Nexus: 收起所选源码节点"},
      {"command":"gushenCompletion.focusApiSource","title":"Guthon Nexus: 查看谷神源码"},
      {"command":"gushenCompletion.refreshAllApiSources","title":"Guthon Nexus: 刷新当前源码视图"},
      {"command":"gushenCompletion.copyApiLocatorLink","title":"Guthon Nexus: 复制源码定位链接"},
      {"command":"gushenCompletion.copyApiAiContext","title":"Guthon Nexus: 复制 AI 上下文"},
      {"command":"gushenCompletion.openApiSourceInBrowser","title":"Guthon Nexus: 在平台定位源码"},
      {"command":"gushenCompletion.showApiInheritance","title":"Guthon Nexus: 查看继承源码"}
    ],
    "viewsContainers": {
      "activitybar": [
        {"id":"guthon","title":"Guthon Nexus","icon":"resources/guthon.svg"}
      ]
    },
    "views": {
      "guthon": [
        {"id":"gushenCompletion.projectDetails","name":"项目详情","type":"webview"},
        {"id":"gushenCompletion.toolView","name":"谷神工作区"},
        {"id":"gushenCompletion.sourceView","name":"谷神源码"}
      ]
    },
    "menus": {
      "view/title": [
        {"command":"gushenCompletion.searchWorkspace","when":"view == gushenCompletion.toolView","group":"navigation@1"},
        {"command":"gushenCompletion.addWorkspace","when":"view == gushenCompletion.toolView","group":"navigation@2"},
        {"command":"gushenCompletion.refreshToolView","when":"view == gushenCompletion.toolView","group":"navigation@3"},
        {"command":"gushenCompletion.locateActiveApiSource","when":"view == gushenCompletion.sourceView","group":"navigation@1"},
        {"command":"gushenCompletion.searchCurrentApiWorkspace","when":"view == gushenCompletion.sourceView","group":"navigation@2"},
        {"command":"gushenCompletion.expandApiSelectedSource","when":"view == gushenCompletion.sourceView","group":"navigation@3"},
        {"command":"gushenCompletion.collapseApiSelectedSource","when":"view == gushenCompletion.sourceView","group":"navigation@4"},
        {"command":"gushenCompletion.refreshAllApiSources","when":"view == gushenCompletion.sourceView","group":"navigation@3"}
      ],
      "view/item/context": [
        {"command":"gushenCompletion.exportAiContext","when":"view == gushenCompletion.toolView && viewItem == guthonWorkspace","group":"navigation@8"},
        {"command":"gushenCompletion.showApiHistory","when":"view == gushenCompletion.toolView && viewItem == guthonWorkspace","group":"navigation@7"},
        {"command":"gushenCompletion.showDiagnosisHistory","when":"view == gushenCompletion.toolView && viewItem == guthonWorkspace","group":"navigation@8"},
        {"command":"gushenCompletion.deleteWorkspace","when":"view == gushenCompletion.toolView && viewItem == guthonWorkspace","group":"danger@1"},
        {"command":"gushenCompletion.openApiSource","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(source|page|procedure|table|view|readonly)$/","group":"navigation@1"},
        {"command":"gushenCompletion.openApiOriginalSource","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(source|page|procedure|table|view|readonly)$/","group":"navigation@2"},
        {"command":"gushenCompletion.previewApiSource","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(source|page|procedure|table|view|readonly)$/","group":"navigation@2"},
        {"command":"gushenCompletion.openApiFragment","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.fragment\\.(fields|script)$/","group":"navigation@1"},
        {"command":"gushenCompletion.openApiPageEditor","when":"view == gushenCompletion.sourceView && viewItem == guthonApi.page","group":"navigation@1"},
        {"command":"gushenCompletion.openApiDesigner","when":"view == gushenCompletion.sourceView && viewItem == guthonApi.page","group":"navigation@2"},
        {"command":"gushenCompletion.showApiPageNodes","when":"view == gushenCompletion.sourceView && viewItem == guthonApi.page","group":"navigation@3"},
        {"command":"gushenCompletion.searchApiPageFields","when":"view == gushenCompletion.sourceView && viewItem == guthonApi.page","group":"navigation@4"},
        {"command":"gushenCompletion.createApiFunction","when":"view == gushenCompletion.sourceView && viewItem == guthonApi.procedure","group":"navigation@2"},
        {"command":"gushenCompletion.copyApiProcedureName","when":"view == gushenCompletion.sourceView && viewItem == guthonApi.procedure","group":"navigation@3"},
        {"command":"gushenCompletion.copyApiQualifiedProcedureName","when":"view == gushenCompletion.sourceView && viewItem == guthonApi.procedure","group":"navigation@3"},
        {"command":"gushenCompletion.showApiProcedureCallers","when":"view == gushenCompletion.sourceView && viewItem == guthonApi.procedure","group":"navigation@3"},
        {"command":"gushenCompletion.syncApiDatabase","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(table|view)$/","group":"navigation@2"},
        {"command":"gushenCompletion.showApiInheritance","when":"view == gushenCompletion.sourceView && viewItem == guthonApi.fragment.script","group":"navigation@2"},
        {"command":"gushenCompletion.showApiInheritance","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(procedure|page)$/","group":"navigation@5"},
        {"command":"gushenCompletion.openApiSourceInBrowser","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(procedure|page)$/","group":"navigation@6"},
        {"command":"gushenCompletion.copyApiLocatorLink","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(source|page|procedure|table|view)$/","group":"navigation@7"},
        {"command":"gushenCompletion.copyApiAiContext","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(source|page|procedure|table|view)$/","group":"navigation@8"},
        {"command":"gushenCompletion.browseApiImpactEvidence","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(source|page|procedure|table|view)$/","group":"navigation@9"},
        {"command":"gushenCompletion.showApiImpact","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(source|page|procedure|table|view)$/","group":"navigation@9"},
        {"command":"gushenCompletion.exportAiContext","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(source|page|procedure|table|view)$/","group":"navigation@10"},
        {"command":"gushenCompletion.refreshApiObject","when":"view == gushenCompletion.sourceView && viewItem =~ /^guthonApi\\.(source|page|procedure|table|view)$/","group":"navigation@11"}
      ],
      "scm/title": [
        {"command":"gushenCompletion.refreshApiScm","when":"scmProvider =~ /^guthon-api-/","group":"navigation@1"},
        {"command":"gushenCompletion.uploadApiSource","when":"scmProvider =~ /^guthon-api-/","group":"navigation@2"}
      ],
      "scm/change/title": [
        {"command":"gushenCompletion.revertApiQuickDiffChange","when":"originalResourceScheme == guthon-api-diff","group":"navigation@1"}
      ],
      "scm/resourceState/context": [
        {"command":"gushenCompletion.openApiSource","when":"scmProvider =~ /^guthon-api-/ && scmResourceState == guthonApi.change","group":"inline@0"},
        {"command":"gushenCompletion.showApiDiff","when":"scmProvider =~ /^guthon-api-/","group":"inline@1"},
        {"command":"gushenCompletion.revertApiSource","when":"scmProvider =~ /^guthon-api-/ && scmResourceState == guthonApi.change","group":"inline@2"},
        {"command":"gushenCompletion.uploadApiSource","when":"scmProvider =~ /^guthon-api-/ && scmResourceState == guthonApi.change","group":"inline@3"},
        {"command":"gushenCompletion.resolveApiConflict","when":"scmProvider =~ /^guthon-api-/ && scmResourceState == guthonApi.conflict","group":"inline@2"}
      ]
    }
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "package": "npm run build:bridge && vsce package --allow-missing-repository --skip-license --out guthon-nexus-vscode.vsix",
    "check": "npm run build:bridge && node --check src/extension.js && node --check src/tool-updater.js && node --check src/tool-workspace.js && node --check scripts/build-bridge.mjs && node --check scripts/build-data.mjs",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {},
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
