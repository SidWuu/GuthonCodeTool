      {"command":"gushenCompletion.showSvnDiff","title":"查看 SVN 差异","category":"Guthon Nexus"},
      {"command":"gushenCompletion.openSvnConflictMerge","title":"查看 SVN 冲突差异","category":"Guthon Nexus"},
      {"command":"gushenCompletion.searchProjects","title":"搜索项目","category":"Guthon Nexus","icon":"$(search)"},
