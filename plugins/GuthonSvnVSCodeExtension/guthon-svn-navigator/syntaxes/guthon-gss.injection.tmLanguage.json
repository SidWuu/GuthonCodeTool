{
  "name": "Guthon GSS Injection",
  "scopeName": "guthon-gss.injection",
  "injectionSelector": "L:source.guthon-gss -comment",
  "patterns": [
    {
      "name": "keyword.control.gushen-vm",
      "match": "#(?:set|if|elseif|else|end|foreach|while|continue|break|try|catch|finally|function|stop|macro|define|include|parse|evaluate)\\b"
    },
    {
      "name": "variable.language.gushen-vm",
      "match": "\\$!?(?:vs\\b|\\{vs\\})"
    },
    {
      "name": "variable.other.gushen-vm",
      "match": "\\$!?(?:\\{[A-Za-z_][A-Za-z0-9_]*\\}|[A-Za-z_][A-Za-z0-9_]*)"
    },
    {
      "name": "variable.parameter.gushen-vm",
      "match": "#\\{[A-Za-z_][A-Za-z0-9_.]*\\}"
    }
  ]
}
