{
  "name": "guthon-nexus-vscode",
  "displayName": "Guthon Nexus",
  "description": "Guthon workspace, source sync, metadata export, workcopy tools, API completions, hover documentation, and source navigation.",
  "version": "2.1.0",
  "publisher": "gushen-local",
  "icon": "resources/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:java",
    "onLanguage:guthon-gss",
    "onLanguage:javascript",
    "onLanguage:sql",
    "onCommand:gushenCompletion.setupTool",
    "onCommand:gushenCompletion.selectExecutionMode",
    "onCommand:gushenCompletion.selectWorkspaceSourceMode",
    "onCommand:gushenCompletion.setSvnCredentials",
    "onCommand:gushenCompletion.openSvnDocument",
    "onCommand:gushenCompletion.openSvnChangeInNexus",
    "onCommand:gushenCompletion.revealSvnSourceFile",
    "onCommand:gushenCompletion.jumpSelectedSvnSource",
    "onCommand:gushenCompletion.locateActiveSvnSource",
    "onCommand:gushenCompletion.expandSelectedSvnSource",
    "onCommand:gushenCompletion.collapseSelectedSvnSource",
    "onCommand:gushenCompletion.searchSvnSource",
    "onCommand:gushenCompletion.refreshSvnSourceView",
    "onCommand:gushenCompletion.refreshSvnScm",
    "onCommand:gushenCompletion.refreshSvnRemoteChanges",
    "onCommand:gushenCompletion.showSvnDiff",
    "onCommand:gushenCompletion.showSvnRawDiff",
    "onCommand:gushenCompletion.revertSvnQuickDiffChange",
    "onCommand:gushenCompletion.showSvnHistory",
    "onCommand:gushenCompletion.manageSvnChanges",
    "onCommand:gushenCompletion.revertSvnChanges",
    "onCommand:gushenCompletion.revertSingleSvnChange",
    "onCommand:gushenCompletion.saveSvnToGuthon",
    "onCommand:gushenCompletion.saveAllSvnNexusChanges",
    "onCommand:gushenCompletion.saveSingleSvnNexusChange",
    "onCommand:gushenCompletion.updateAllSvnChanges",
    "onCommand:gushenCompletion.updateSingleSvnChange",
    "onFileSystem:guthon-svn-edit",
    "onCommand:gushenCompletion.startBridge",
    "onCommand:gushenCompletion.stopBridge",
    "onCommand:gushenCompletion.initSourceIndex",
    "onCommand:gushenCompletion.syncWorkspaceSource",
    "onCommand:gushenCompletion.syncWorkspaceAll",
    "onCommand:gushenCompletion.openWorkspace",
    "onCommand:gushenCompletion.openToolHome",
    "onCommand:gushenCompletion.editConfig",
    "onCommand:gushenCompletion.reindexCalls",
    "onCommand:gushenCompletion.exportMarkdown",
    "onCommand:gushenCompletion.exportSchema",
    "onCommand:gushenCompletion.exportBillTypes",
    "onCommand:gushenCompletion.exportSystemScripts",
    "onCommand:gushenCompletion.exportViews",
    "onCommand:gushenCompletion.runDoctor",
    "onCommand:gushenCompletion.runDiagnosis",
    "onCommand:gushenCompletion.inspectWorkcopy",
    "onCommand:gushenCompletion.initializeSvn",
    "onCommand:gushenCompletion.importSvnScope",
    "onCommand:gushenCompletion.editSvnScope",
    "onCommand:gushenCompletion.refreshSvn",
    "onCommand:gushenCompletion.showSvnStatus",
    "onCommand:gushenCompletion.refreshToolView",
    "onView:gushenCompletion.toolView",
    "onView:gushenCompletion.svnSourceView"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configurationDefaults": {
      "workbench.list.horizontalScrolling": true,
      "workbench.list.defaultFindMode": "filter",
      "workbench.list.defaultFindMatchType": "fuzzy",
      "scm.alwaysShowActions": true,
      "scm.repositories.selectionMode": "multiple"
    },
    "languages": [
      {
        "id": "guthon-gss",
        "aliases": ["Guthon GSS", "gss"],
        "extensions": [".gss"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "java",
        "extensions": [".vm"]
      }
    ],
    "grammars": [
      {
        "language": "guthon-gss",
        "scopeName": "source.guthon-gss",
        "path": "./syntaxes/guthon-gss.tmLanguage.json"
      },
      {
        "scopeName": "guthon-gss.injection",
        "path": "./syntaxes/guthon-gss.injection.tmLanguage.json",
        "injectTo": ["source.guthon-gss"]
      }
    ],
    "configuration": {
      "title": "Guthon Nexus",
      "properties": {
        "gushenCompletion.rulesPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a custom rules.json file. Empty means use the extension bundled rules.json."
        },
        "gushenCompletion.toolPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the packaged GuthonCodeTool executable."
        },
        "gushenCompletion.toolHome": {
          "type": "string",
          "default": "",
          "description": "Absolute directory for GuthonCodeTool local config, readonly source, workcopy, and indexes."
        },
        "gushenCompletion.executionMode": {
          "type": "string",
          "enum": ["packaged", "development"],
          "default": "packaged",
          "description": "Use the packaged application or run Python scripts directly from a GuthonCodeTool source checkout."
        },
        "gushenCompletion.developmentRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the GuthonCodeTool source checkout used in development mode."
        }
      }
    },
    "commands": [
      { "command": "gushenCompletion.setupTool", "title": "Guthon Nexus: 设置/切换工作空间" },
      { "command": "gushenCompletion.selectExecutionMode", "title": "Guthon Nexus: 切换运行模式" },
      { "command": "gushenCompletion.selectWorkspaceSourceMode", "title": "Guthon Nexus: 设置项目源码来源" },
      { "command": "gushenCompletion.setSvnCredentials", "title": "Guthon Nexus: 设置工作区 SVN 登录" },
      { "command": "gushenCompletion.focusSvnSource", "title": "Guthon Nexus: 查看谷神同步源码" },
      { "command": "gushenCompletion.openSvnDocument", "title": "Guthon Nexus: 打开 SVN 虚拟源码" },
      { "command": "gushenCompletion.openSvnChangeInNexus", "title": "Guthon Nexus: 在 Nexus 中编辑", "icon": "$(edit)" },
      { "command": "gushenCompletion.revealSvnSourceFile", "title": "Guthon Nexus: 跳转到资源管理器原文件", "icon": "$(go-to-file)" },
      { "command": "gushenCompletion.jumpSelectedSvnSource", "title": "Guthon Nexus: 跳转所选 SVN 原文件", "icon": "$(go-to-file)" },
      { "command": "gushenCompletion.locateActiveSvnSource", "title": "Guthon Nexus: 定位当前编辑源码", "icon": "$(target)" },
      { "command": "gushenCompletion.expandSelectedSvnSource", "title": "Guthon Nexus: 展开所选 SVN 节点", "icon": "$(expand-all)" },
      { "command": "gushenCompletion.collapseSelectedSvnSource", "title": "Guthon Nexus: 收缩所选 SVN 节点", "icon": "$(collapse-all)" },
      { "command": "gushenCompletion.searchSvnSource", "title": "Guthon Nexus: 搜索谷神源码", "icon": "$(search)" },
      { "command": "gushenCompletion.refreshSvnSourceView", "title": "Guthon Nexus: 刷新谷神源码", "icon": "$(refresh)" },
      { "command": "gushenCompletion.refreshSvnScm", "title": "Guthon Nexus: 刷新 SVN 变更", "icon": "$(refresh)" },
      { "command": "gushenCompletion.refreshSvnRemoteChanges", "title": "Guthon Nexus: 检查 SVN 远程变更", "icon": "$(cloud-download)" },
      { "command": "gushenCompletion.showSvnDiff", "title": "Guthon Nexus: 查看 SVN 差异" },
      { "command": "gushenCompletion.showSvnRawDiff", "title": "Guthon Nexus: 查看 SVN 原始文件差异" },
      { "command": "gushenCompletion.revertSvnQuickDiffChange", "title": "Guthon Nexus: 撤销当前差异块", "icon": "$(discard)" },
      { "command": "gushenCompletion.showSvnHistory", "title": "Guthon Nexus: 查看 SVN 历史", "icon": "$(history)" },
      { "command": "gushenCompletion.manageSvnChanges", "title": "Guthon Nexus: 管理本地源码变更", "icon": "$(source-control)" },
      { "command": "gushenCompletion.revertSvnChanges", "title": "Guthon Nexus: 放弃 SVN 本地修改", "icon": "$(discard)" },
      { "command": "gushenCompletion.revertSingleSvnChange", "title": "Guthon Nexus: 放弃此文件修改", "icon": "$(discard)" },
      { "command": "gushenCompletion.saveSvnToGuthon", "title": "Guthon Nexus: 保存到谷神", "icon": "$(cloud-upload)" },
      { "command": "gushenCompletion.saveAllSvnNexusChanges", "title": "Guthon Nexus: 提交全部 Nexus 修改", "icon": "$(cloud-upload)" },
      { "command": "gushenCompletion.saveSingleSvnNexusChange", "title": "Guthon Nexus: 提交此 Nexus 修改", "icon": "$(cloud-upload)" },
      { "command": "gushenCompletion.updateAllSvnChanges", "title": "Guthon Nexus: 更新全部远程变更", "icon": "$(cloud-download)" },
      { "command": "gushenCompletion.updateSingleSvnChange", "title": "Guthon Nexus: 更新此远程变更", "icon": "$(cloud-download)" },
      { "command": "gushenCompletion.startBridge", "title": "Guthon Nexus: 启动 Guthon Bridge" },
      { "command": "gushenCompletion.stopBridge", "title": "Guthon Nexus: 停止 Guthon Bridge" },
      { "command": "gushenCompletion.initSourceIndex", "title": "Guthon Nexus: 拉取源码重建索引" },
      { "command": "gushenCompletion.syncWorkspaceSource", "title": "Guthon Nexus: 拉取源码" },
      { "command": "gushenCompletion.syncWorkspaceAll", "title": "Guthon Nexus: 同步工作区全部资料" },
      { "command": "gushenCompletion.openWorkspace", "title": "Guthon Nexus: 打开工作区目录" },
      { "command": "gushenCompletion.openToolHome", "title": "Guthon Nexus: 打开本地数据目录" },
      { "command": "gushenCompletion.editConfig", "title": "Guthon Nexus: 编辑配置文件" },
      { "command": "gushenCompletion.reindexCalls", "title": "Guthon Nexus: 重建索引" },
      { "command": "gushenCompletion.exportMarkdown", "title": "Guthon Nexus: 导出源码索引文档" },
      { "command": "gushenCompletion.exportSchema", "title": "Guthon Nexus: 导出表结构" },
      { "command": "gushenCompletion.exportBillTypes", "title": "Guthon Nexus: 导出单据类型" },
      { "command": "gushenCompletion.exportSystemScripts", "title": "Guthon Nexus: 导出系统脚本" },
      { "command": "gushenCompletion.exportViews", "title": "Guthon Nexus: 导出视图源码" },
      { "command": "gushenCompletion.runDoctor", "title": "Guthon Nexus: 检查本地环境" },
      { "command": "gushenCompletion.runDiagnosis", "title": "Guthon Nexus: 执行源码逻辑排查" },
      { "command": "gushenCompletion.inspectWorkcopy", "title": "Guthon Nexus: 检查或打包 Workcopy" },
      { "command": "gushenCompletion.initializeSvn", "title": "Guthon Nexus: 从 SVN 范围配置检出/更新" },
      { "command": "gushenCompletion.importSvnScope", "title": "Guthon Nexus: 导入 SVN checkout 配置" },
      { "command": "gushenCompletion.editSvnScope", "title": "Guthon Nexus: 编辑 SVN 范围配置" },
      { "command": "gushenCompletion.refreshSvn", "title": "Guthon Nexus: 更新指定 SVN working copy", "icon": "$(sync)" },
      { "command": "gushenCompletion.showSvnStatus", "title": "Guthon Nexus: 查看 SVN 状态与差异" },
      { "command": "gushenCompletion.refreshToolView", "title": "Guthon Nexus: 刷新工具面板", "icon": "$(refresh)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "guthon", "title": "Guthon Nexus", "icon": "resources/guthon.svg" }
      ]
    },
    "views": {
      "guthon": [
        { "id": "gushenCompletion.toolView", "name": "Guthon Nexus" },
        { "id": "gushenCompletion.svnSourceView", "name": "谷神源码" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "gushenCompletion.refreshToolView", "when": "view == gushenCompletion.toolView", "group": "navigation" },
        { "command": "gushenCompletion.jumpSelectedSvnSource", "when": "view == gushenCompletion.svnSourceView", "group": "navigation@1" },
        { "command": "gushenCompletion.locateActiveSvnSource", "when": "view == gushenCompletion.svnSourceView", "group": "navigation@2" },
        { "command": "gushenCompletion.searchSvnSource", "when": "view == gushenCompletion.svnSourceView", "group": "navigation@3" },
        { "command": "gushenCompletion.expandSelectedSvnSource", "when": "view == gushenCompletion.svnSourceView", "group": "navigation@4" },
        { "command": "gushenCompletion.collapseSelectedSvnSource", "when": "view == gushenCompletion.svnSourceView", "group": "navigation@5" },
        { "command": "gushenCompletion.refreshSvnSourceView", "when": "view == gushenCompletion.svnSourceView", "group": "navigation@6" }
      ],
      "view/item/context": [
        { "command": "gushenCompletion.revealSvnSourceFile", "when": "view == gushenCompletion.svnSourceView && viewItem == guthonSvnSource", "group": "navigation@1" }
      ],
      "scm/title": [
        { "command": "gushenCompletion.refreshSvnScm", "when": "scmProvider =~ /^guthon-svn-/", "group": "navigation@1" },
        { "command": "gushenCompletion.refreshSvnRemoteChanges", "when": "scmProvider =~ /^guthon-svn-/", "group": "navigation@2" },
        { "command": "gushenCompletion.saveAllSvnNexusChanges", "when": "scmProvider =~ /^guthon-svn-/", "group": "navigation@3" },
        { "command": "gushenCompletion.updateAllSvnChanges", "when": "scmProvider =~ /^guthon-svn-/", "group": "navigation@4" }
      ],
      "scm/resourceGroup/context": [
        { "command": "gushenCompletion.refreshSvnScm", "when": "scmProvider =~ /^guthon-svn-/", "group": "inline@1" },
        { "command": "gushenCompletion.refreshSvnRemoteChanges", "when": "scmProvider =~ /^guthon-svn-/", "group": "inline@2" },
        { "command": "gushenCompletion.saveAllSvnNexusChanges", "when": "scmProvider =~ /^guthon-svn-/", "group": "inline@3" },
        { "command": "gushenCompletion.updateAllSvnChanges", "when": "scmProvider =~ /^guthon-svn-/", "group": "inline@4" }
      ],
      "scm/change/title": [
        { "command": "gushenCompletion.revertSvnQuickDiffChange", "when": "originalResourceScheme == guthon-svn-diff", "group": "navigation@1" }
      ],
      "scm/resourceState/context": [
        { "command": "gushenCompletion.openSvnChangeInNexus", "when": "scmProvider =~ /^guthon-svn-/ && scmResourceState =~ /^guthonSvn\\.(LOCAL_MODIFIED|EXTERNAL_MODIFIED)\\.nexus$/", "group": "inline@1" },
        { "command": "gushenCompletion.revertSingleSvnChange", "when": "scmProvider =~ /^guthon-svn-/ && scmResourceState == guthonSvn.LOCAL_MODIFIED.nexus", "group": "inline@2" },
        { "command": "gushenCompletion.saveSingleSvnNexusChange", "when": "scmProvider =~ /^guthon-svn-/ && scmResourceState == guthonSvn.LOCAL_MODIFIED.nexus", "group": "inline@3" },
        { "command": "gushenCompletion.updateSingleSvnChange", "when": "scmProvider =~ /^guthon-svn-/ && scmResourceState == guthonSvn.REMOTE", "group": "inline@1" },
        { "command": "gushenCompletion.showSvnHistory", "when": "scmProvider =~ /^guthon-svn-/ && scmResourceState != guthonSvn.REMOTE", "group": "navigation@1" },
        { "command": "gushenCompletion.showSvnRawDiff", "when": "scmProvider =~ /^guthon-svn-/ && scmResourceState != guthonSvn.REMOTE", "group": "navigation@2" }
      ]
    }
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "package": "npm run build:bridge && vsce package --allow-missing-repository --skip-license --out guthon-nexus-vscode.vsix",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {}
}
