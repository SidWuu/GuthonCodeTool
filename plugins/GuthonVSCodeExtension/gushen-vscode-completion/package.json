{
  "name": "gushen-vscode-completion",
  "displayName": "Guthon Nexus",
  "description": "Guthon workspace, source sync, metadata export, workcopy tools, API completions, hover documentation, and source navigation.",
  "version": "0.1.0",
  "publisher": "gushen-local",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onLanguage:javascript",
    "onLanguage:sql",
    "onCommand:gushenCompletion.setupTool",
    "onCommand:gushenCompletion.startBridge",
    "onCommand:gushenCompletion.stopBridge",
    "onCommand:gushenCompletion.initSourceIndex",
    "onCommand:gushenCompletion.syncActiveSource",
    "onCommand:gushenCompletion.syncActiveAll",
    "onCommand:gushenCompletion.openToolHome",
    "onCommand:gushenCompletion.editConfig",
    "onCommand:gushenCompletion.reindexCalls",
    "onCommand:gushenCompletion.exportMarkdown",
    "onCommand:gushenCompletion.exportSchema",
    "onCommand:gushenCompletion.exportBillTypes",
    "onCommand:gushenCompletion.exportSystemScripts",
    "onCommand:gushenCompletion.exportViews",
    "onCommand:gushenCompletion.runDoctor",
    "onCommand:gushenCompletion.runDiagnosis",
    "onCommand:gushenCompletion.inspectWorkcopy",
    "onCommand:gushenCompletion.refreshToolView",
    "onView:gushenCompletion.toolView"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configuration": {
      "title": "Guthon Nexus",
      "properties": {
        "gushenCompletion.rulesPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a custom rules.json file. Empty means use the extension bundled rules.json."
        },
        "gushenCompletion.toolPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the packaged GuthonCodeTool executable."
        },
        "gushenCompletion.toolHome": {
          "type": "string",
          "default": "",
          "description": "Absolute directory for GuthonCodeTool local config, readonly source, workcopy, and indexes."
        }
      }
    },
    "commands": [
      { "command": "gushenCompletion.setupTool", "title": "Guthon Nexus: 初始化工作区" },
      { "command": "gushenCompletion.startBridge", "title": "Guthon Nexus: 启动 Guthon Bridge" },
      { "command": "gushenCompletion.stopBridge", "title": "Guthon Nexus: 停止 Guthon Bridge" },
      { "command": "gushenCompletion.initSourceIndex", "title": "Guthon Nexus: 初始化源码索引" },
      { "command": "gushenCompletion.syncActiveSource", "title": "Guthon Nexus: 同步当前 ACTIVE 源码" },
      { "command": "gushenCompletion.syncActiveAll", "title": "Guthon Nexus: 同步当前 ACTIVE 全部资料" },
      { "command": "gushenCompletion.openToolHome", "title": "Guthon Nexus: 打开本地数据目录" },
      { "command": "gushenCompletion.editConfig", "title": "Guthon Nexus: 编辑配置文件" },
      { "command": "gushenCompletion.reindexCalls", "title": "Guthon Nexus: 重建本地调用索引" },
      { "command": "gushenCompletion.exportMarkdown", "title": "Guthon Nexus: 导出源码索引文档" },
      { "command": "gushenCompletion.exportSchema", "title": "Guthon Nexus: 导出表结构" },
      { "command": "gushenCompletion.exportBillTypes", "title": "Guthon Nexus: 导出单据类型" },
      { "command": "gushenCompletion.exportSystemScripts", "title": "Guthon Nexus: 导出系统脚本" },
      { "command": "gushenCompletion.exportViews", "title": "Guthon Nexus: 导出视图源码" },
      { "command": "gushenCompletion.runDoctor", "title": "Guthon Nexus: 检查本地环境" },
      { "command": "gushenCompletion.runDiagnosis", "title": "Guthon Nexus: 执行源码逻辑排查" },
      { "command": "gushenCompletion.inspectWorkcopy", "title": "Guthon Nexus: 检查或打包 Workcopy" },
      { "command": "gushenCompletion.refreshToolView", "title": "Guthon Nexus: 刷新工具面板", "icon": "$(refresh)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "guthon", "title": "Guthon Nexus", "icon": "resources/guthon.svg" }
      ]
    },
    "views": {
      "guthon": [
        { "id": "gushenCompletion.toolView", "name": "Guthon Nexus" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "gushenCompletion.refreshToolView", "when": "view == gushenCompletion.toolView", "group": "navigation" }
      ]
    }
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "package": "npm run build:bridge && vsce package --allow-missing-repository --skip-license --out GuthonCodeTool-vscode.vsix",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {}
}
